{
  "name": "@pith-cms/storage-github",
  "version": "0.2.1",
  "description": "GitHub Contents API repository adapter with direct and pull-request publishing for Pith.",
  "license": "MIT",
  "keywords": [
    "cms",
    "github",
    "nextjs",
    "pull-request",
    "storage"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankstevens1/pith-cms.git",
    "directory": "packages/storage-github"
  },
  "homepage": "https://github.com/frankstevens1/pith-cms#readme",
  "bugs": {
    "url": "https://github.com/frankstevens1/pith-cms/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pith-cms/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
