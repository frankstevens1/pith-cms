# Generate with: pnpm pith:hash-password. Its .env output escapes every "$" in the PHC hash,
# because Next.js expands unescaped "$" values when loading .env files.
PITH_PASSWORD_HASH=

# Use a unique high-entropy server secret (at least 32 characters).
PITH_SESSION_SECRET=

# Leave unset for production HTTPS. Set only for local HTTP development.
# PITH_SESSION_SECURE=false

# Separate high-entropy preview secret (at least 32 bytes). Required to enable authenticated preview.
PITH_PREVIEW_SECRET=

# Public docs destination. Defaults to http://localhost:3101 for local development.
# NEXT_PUBLIC_PITH_DOCS_URL=https://docs.example.com

# The default is filesystem. Set to github only with server-only credentials.
PITH_REPOSITORY_PROVIDER=filesystem

# PITH_GITHUB_OWNER=
# PITH_GITHUB_REPOSITORY=
# PITH_GITHUB_BRANCH=main
# PITH_GITHUB_TOKEN=
# PITH_GITHUB_PUBLISHING_MODE=direct
# PITH_GITHUB_BRANCH_PREFIX=pith/

# Or configure all three GitHub App settings instead of PITH_GITHUB_TOKEN.
# PITH_GITHUB_APP_ID=
# PITH_GITHUB_APP_PRIVATE_KEY=
# PITH_GITHUB_INSTALLATION_ID=
